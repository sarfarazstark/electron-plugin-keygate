{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"baseUrl": ".",
		"paths": {
			"electron-plugin-keygate": ["./lib/main/index.ts"],
			"electron-plugin-keygate/renderer": ["./lib/renderer/index.ts"],
			"electron-plugin-keygate/preload": ["./lib/preload/index.ts"],
			"electron-plugin-keygate/preload/sandboxed": ["./lib/preload/sandboxed.ts"],
			"electron-plugin-keygate/preload/api": ["./lib/preload/api.ts"]
		},
		"declaration": true,
		"sourceMap": true,
		"noEmit": true
	},
	"include": ["lib", "test", "scripts", "examples"]
}
